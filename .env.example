# Names only; copy to .env.local (local) / set in Vercel (all environments). Never commit real values.

# --- database / auth (already set in Vercel) ---
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- REQUIRED FOR LAUNCH (not yet set in Vercel) ---
CLERK_WEBHOOK_SECRET=        # Clerk dashboard > Webhooks > endpoint https://<domain>/api/webhooks/clerk (user.created/updated/deleted)
STRIPE_SECRET_KEY=           # sk_test_... for preview/dev, sk_live_... for production
STRIPE_WEBHOOK_SECRET=       # whsec_... from the Stripe webhook endpoint https://<domain>/api/webhooks/stripe
ADMIN_EMAILS=                # comma-separated, verified emails that get admin (lib/admin.ts)

# --- optional ---
NEXT_PUBLIC_APP_URL=         # https://landoracle.ai ; falls back to the request origin if unset
AI_ASSISTANT_ENABLED=        # "true" removes the "Coming soon" badge on Pro/Statewide (assistant code lives on feat/ai-assistant)
